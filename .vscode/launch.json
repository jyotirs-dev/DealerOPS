{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Flask (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "5001",
        "FLASK_DEBUG": "1"
      }
    },
    {
      "name": "Frontend: Vite dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend: Open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "DealerOPS: Full Stack (backend + frontend)",
      "configurations": [
        "Backend: Flask (app.py)",
        "Frontend: Vite dev server"
      ],
      "stopAll": true
    }
  ]
}
